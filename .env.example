# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=adminpassword

# Open WebUI – must be at least 32 random characters; rotate before production use
WEBUI_SECRET_KEY=changeme-super-secret-key-32chars-CHANGE-THIS

# Open WebUI Keycloak client secret (matches realm-export.json)
OPENWEBUI_OAUTH_CLIENT_SECRET=openwebui-secret

# MCP Server Keycloak client secret (matches realm-export.json)
MCP_SERVER_CLIENT_SECRET=mcp-server-secret
